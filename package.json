{
  "name": "axion-design-system",
  "version": "0.2.0",
  "private": true,
  "description": "Design system independente do Axion: tokens, componentes, marca e padroes.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p packages/ui/tsconfig.build.json && tailwindcss -i packages/ui/src/react/theme.css -o packages/ui/dist/theme.css --minify",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs && node tests/diagrams.mjs",
    "check": "npm run build && npm test",
    "prepack": "npm run check",
    "test:unit": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 -c apps/storybook/.storybook --no-open --disable-telemetry",
    "build:storybook": "storybook build -c apps/storybook/.storybook -o storybook-static --disable-telemetry",
    "serve:storybook": "node scripts/serve-storybook.mjs",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run check && npm run test:unit && npm run build:storybook"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "29.1.1",
    "lucide": "1.48.0",
    "parse5": "8.0.1",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
