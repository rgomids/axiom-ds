{
  "component": {
    "diagram": {
      "muted": {
        "$type": "color",
        "$value": "{semantic.surface.muted}"
      },
      "canvas": {
        "$type": "color",
        "$value": "{semantic.surface.canvas}"
      },
      "panel": {
        "$type": "color",
        "$value": "{semantic.surface.default}"
      },
      "line": {
        "$type": "color",
        "$value": "{semantic.border.default}"
      },
      "connector": {
        "$type": "color",
        "$value": "{semantic.text.muted}"
      },
      "selection": {
        "$type": "color",
        "$value": "{semantic.action.primary}"
      },
      "radius": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "px"
        }
      },
      "controlSize": {
        "$type": "dimension",
        "$value": "{space.32}"
      },
      "nodeWidth": {
        "$type": "dimension",
        "$value": {
          "value": 208,
          "unit": "px"
        }
      }
    },
    "button": {
      "height": {
        "$type": "dimension",
        "$value": "{control.height.md}"
      },
      "heightSm": {
        "$type": "dimension",
        "$value": "{control.height.sm}"
      },
      "heightLg": {
        "$type": "dimension",
        "$value": "{control.height.lg}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.sm}"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{space.8}"
      },
      "background": {
        "$type": "color",
        "$value": "{semantic.action.primary}"
      },
      "text": {
        "$type": "color",
        "$value": "{semantic.action.onPrimary}"
      }
    },
    "field": {
      "height": {
        "$type": "dimension",
        "$value": "{control.height.md}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.sm}"
      },
      "border": {
        "$type": "color",
        "$value": "{semantic.border.control}"
      }
    },
    "icon": {
      "radius": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "px"
        }
      },
      "size": {
        "$type": "dimension",
        "$value": {
          "value": 18,
          "unit": "px"
        }
      },
      "stroke": {
        "$type": "number",
        "$value": 2
      }
    },
    "card": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.md}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{space.20}"
      },
      "border": {
        "$type": "color",
        "$value": "{semantic.border.default}"
      }
    },
    "dialog": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.lg}"
      }
    },
    "badge": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.xs}"
      }
    }
  }
}
