{
  "component": {
    "diagram": {
      "muted": { "$type": "color", "$value": "{semantic.surface.muted}" },
      "canvas": { "$type": "color", "$value": "{semantic.surface.canvas}" },
      "panel": { "$type": "color", "$value": "{semantic.surface.default}" },
      "line": { "$type": "color", "$value": "{semantic.border.default}" },
      "connector": { "$type": "color", "$value": "{semantic.text.muted}" },
      "selection": { "$type": "color", "$value": "{semantic.action.primary}" },
      "radius": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
      "controlSize": { "$type": "dimension", "$value": "{space.32}" },
      "nodeWidth": { "$type": "dimension", "$value": { "value": 208, "unit": "px" } }
    },
    "button": {
      "height": {
        "$type": "dimension",
        "$value": {
          "value": 38,
          "unit": "px"
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.sm}"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{space.8}"
      },
      "background": {
        "$type": "color",
        "$value": "{semantic.action.primary}"
      },
      "text": {
        "$type": "color",
        "$value": "{semantic.action.onPrimary}"
      }
    },
    "field": {
      "height": {
        "$type": "dimension",
        "$value": {
          "value": 40,
          "unit": "px"
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.sm}"
      }
    },
    "icon": {
      "radius": {
        "$type": "dimension",
        "$value": { "value": 0, "unit": "px" }
      },
      "size": {
        "$type": "dimension",
        "$value": {
          "value": 18,
          "unit": "px"
        }
      },
      "stroke": {
        "$type": "number",
        "$value": 2
      }
    }
  }
}
