{
  "semantic": {
    "surface": {
      "canvas": {
        "$type": "color",
        "$value": "{color.canvas}"
      },
      "default": {
        "$type": "color",
        "$value": "{color.white}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.surface-muted}"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{color.ink-900}"
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.slate-600}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.slate-500}"
      }
    },
    "action": {
      "primary": {
        "$type": "color",
        "$value": "{color.blue}"
      },
      "hover": {
        "$type": "color",
        "$value": "{color.blue-hover}"
      },
      "onPrimary": {
        "$type": "color",
        "$value": "{color.white}"
      }
    },
    "focus": {
      "ring": {
        "$type": "color",
        "$value": "{color.blue}"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.border-strong}"
      },
      "control": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4823529411764706, 0.5176470588235295, 0.5764705882352941],
          "alpha": 1
        }
      }
    },
    "status": {
      "danger": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.7058823529411765, 0.13725490196078433, 0.09411764705882353],
          "alpha": 1
        }
      },
      "onDanger": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "alpha": 1
        }
      },
      "success": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.023529411764705882, 0.4627450980392157, 0.2784313725490196],
          "alpha": 1
        }
      }
    },
    "overlay": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.06274509803921569, 0.09411764705882353, 0.1568627450980392],
        "alpha": 0.65
      }
    }
  }
}
